<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ovkdesktop.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ovkdesktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ovkdesktop.Converters"
    xmlns:models="using:ovkdesktop.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ClientContentBackgroundBrush}">

    <Page.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToSymbolConverter x:Key="BoolToSymbolConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
        <converters:SecondsToTimeStringConverter x:Key="SecondsToTimeStringConverter"/>
        
        <!-- template for displaying audio record -->
        <DataTemplate x:Key="AudioItemTemplate" x:DataType="models:Audio">
            <Grid Margin="0,5" Height="60" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- cover of track -->
                <Border Grid.Column="0" Width="50" Height="50" Margin="0,0,10,0" 
                        CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Image Source="{x:Bind ThumbUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill"/>
                </Border>
                
                <!-- information about track -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" 
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" 
                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind Artist, Mode=OneWay}" 
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" 
                               Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.8"/>
                </StackPanel>
                
                <!-- duration of track -->
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0" 
                           Text="{x:Bind Duration, Mode=OneWay, Converter={StaticResource TimeSpanToStringConverter}}" 
                           Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.8"/>
                
                <!-- button to add to favorites; the colours come from the theme palette -->
                <Button Grid.Column="3" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0"
                        Click="FavoriteButton_Click" ToolTipService.ToolTip="{x:Bind IsAdded, Mode=OneWay, Converter={StaticResource BoolToSymbolConverter}, ConverterParameter='Убрать из избранного|Добавить в избранное'}">
                    <Grid>
                        <FontIcon Glyph="&#xE00B;" FontSize="16"
                                  Foreground="{ThemeResource ClientSubtleTextBrush}"
                                  Visibility="{x:Bind IsAdded, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <FontIcon Glyph="&#xEB52;" FontSize="16"
                                  Foreground="{ThemeResource ClientLikeActiveBrush}"
                                  Visibility="{x:Bind IsAdded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,48,24,20" MaxWidth="1240" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Spacing="4">
                <TextBlock Text="Музыка" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Ваша медиатека и рекомендации" Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button x:Name="RefreshButton" Click="RefreshButton_Click" Style="{StaticResource CompactActionButtonStyle}" ToolTipService.ToolTip="Обновить">
                    <FontIcon Glyph="&#xE72C;"/>
                </Button>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1" Margin="24,0,24,20" MaxWidth="1240" HorizontalAlignment="Stretch">
            <Pivot x:Name="AudioPivot" SelectionChanged="AudioPivot_SelectionChanged" 
                   Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14">
                <PivotItem Header="Мои аудиозаписи">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock x:Name="MyAudioHeader" Grid.Row="0" Text="{x:Bind ViewModel.MyAudioHeaderText, Mode=OneWay}" 
                                   Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,10,0,10"/>
                        
                        <ListView x:Name="MyAudioListView" Grid.Row="1" 
                                  ItemsSource="{x:Bind ViewModel.MyAudioCollection, Mode=OneWay}" 
                                  ItemTemplate="{StaticResource AudioItemTemplate}"
                                  IsItemClickEnabled="True"
                                  ItemClick="PlayAudio"
                                  SelectionMode="Single"
                                  Margin="0,0,0,10"
                                  Background="Transparent"/>
                        
                        <ProgressRing x:Name="MyAudioLoadingRing" IsActive="{x:Bind ViewModel.IsLoadingMyAudio, Mode=OneWay}"
                                      Width="50" Height="50"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Grid.RowSpan="2"/>

                        <StackPanel Grid.Row="1" Spacing="12"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.IsMyAudioEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE00B;" Style="{StaticResource EmptyStateGlyphStyle}"/>
                            <TextBlock Text="Здесь пока пусто" Style="{StaticResource EmptyStateTitleStyle}"/>
                            <TextBlock Text="Добавляйте треки в избранное сердечком на вкладках «Популярные» и «Поиск» — они появятся здесь."
                                       Style="{StaticResource EmptyStateBodyStyle}"/>
                        </StackPanel>
                    </Grid>
                </PivotItem>
                
                <PivotItem Header="Популярные">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="Популярные аудиозаписи" 
                                   Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,10,0,10"/>
                        
                        <ListView x:Name="PopularAudioListView" Grid.Row="1" 
                                  ItemsSource="{x:Bind ViewModel.PopularAudioCollection, Mode=OneWay}" 
                                  ItemTemplate="{StaticResource AudioItemTemplate}"
                                  IsItemClickEnabled="True"
                                  ItemClick="PlayAudio"
                                  SelectionMode="Single"
                                  Margin="0,0,0,10"
                                  Background="Transparent"/>
                        
                        <ProgressRing x:Name="PopularLoadingRing" IsActive="{x:Bind ViewModel.IsLoadingPopularAudio, Mode=OneWay}" 
                                      Width="50" Height="50" 
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Grid.RowSpan="2"/>
                    </Grid>
                </PivotItem>
                
                <PivotItem Header="Поиск">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.SearchHeaderText, Mode=OneWay}" 
                                   Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,10,0,10"/>
                        
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                            <AutoSuggestBox x:Name="SearchBoxInTab" Width="300" PlaceholderText="Введите название или исполнителя..." 
                                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            CornerRadius="4"/>
                            <Button x:Name="SearchButtonInTab" Command="{x:Bind ViewModel.SearchAudioCommand}" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;"/>
                                    <TextBlock Text="Найти"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        
                        <ListView x:Name="RecommendedAudioListView" Grid.Row="2" 
                                  ItemsSource="{x:Bind ViewModel.RecommendedAudioCollection, Mode=OneWay}" 
                                  ItemTemplate="{StaticResource AudioItemTemplate}"
                                  IsItemClickEnabled="True"
                                  ItemClick="PlayAudio"
                                  SelectionMode="Single"
                                  Margin="0,0,0,10"
                                  Background="Transparent"/>
                        
                        <ProgressRing x:Name="SearchLoadingRing" IsActive="{x:Bind ViewModel.IsLoadingSearchAudio, Mode=OneWay}" 
                                      Width="50" Height="50" 
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Grid.RowSpan="3"/>
                    </Grid>
                </PivotItem>
            </Pivot>
            
            <ProgressRing x:Name="LoadingProgressRing" IsActive="{x:Bind ViewModel.IsGlobalLoading, Mode=OneWay}" 
                          Width="50" Height="50" 
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>
