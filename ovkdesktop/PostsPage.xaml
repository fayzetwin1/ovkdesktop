<Page
    x:Class="ovkdesktop.PostsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ovkdesktop.Controls"
    xmlns:models="using:ovkdesktop.Models"
    xmlns:converters="using:ovkdesktop.Converters"
    Background="{ThemeResource ClientContentBackgroundBrush}"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <DataTemplate x:Key="UnifiedPostTemplate" x:DataType="models:BasePost">
            <controls:PostCardControl Post="{Binding}"
                                      AuthorInvoked="PostCard_AuthorInvoked"
                                      LikeInvoked="PostCard_LikeInvoked"
                                      CommentInvoked="PostCard_CommentInvoked"
                                      RepostInvoked="PostCard_RepostInvoked"/>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!--
            The list uses Stretch + MaxWidth rather than Center. With Center the ListView
            shrinks to its content, so while the feed was empty or still loading the whole
            column (header included) visibly narrowed and then snapped back once posts
            arrived. Stretch keeps the width stable and MaxWidth still centres the column.
        -->
        <ListView x:Name="PostsListView"
                  Loaded="PostsListView_Loaded"
                  ItemsSource="{x:Bind ViewModel.NewsPosts, Mode=OneWay}"
                  ItemTemplate="{StaticResource UnifiedPostTemplate}"
                  SelectionMode="None"
                  MaxWidth="1240"
                  HorizontalAlignment="Stretch"
                  Margin="24,12,24,0"
                  ShowsScrollingPlaceholders="False">
            
            <ListView.Header>
                <Grid Margin="0,36,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="NewsPostsLabel" Text="Новости" Style="{StaticResource PageTitleTextStyle}"/>
                        <TextBlock Text="Публикации людей и сообществ OpenVK" Style="{StaticResource PageSubtitleTextStyle}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource CompactActionButtonStyle}"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Обновить ленту"
                            AutomationProperties.Name="Обновить ленту">
                        <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                    </Button>
                </Grid>
            </ListView.Header>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>


            <ListView.Footer>
                <StackPanel Margin="0,10,0,40">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" 
                                  Width="32"
                                  Height="32"
                                  Margin="0,0,0,10"/>

                    <Button Content="Загрузить ещё..."
                            Command="{x:Bind ViewModel.LoadMoreCommand}"
                            Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </ListView.Footer>
        </ListView>

        <!-- Initial Loading Overlay -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="15"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="True" Width="44" Height="44" />
            <TextBlock Text="Собираем свежие публикации…" Style="{StaticResource PageSubtitleTextStyle}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Nothing to show -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    MaxWidth="420"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon Glyph="&#xE7BA;" Style="{StaticResource EmptyStateGlyphStyle}"/>
            <TextBlock Text="Лента пока пуста" Style="{StaticResource EmptyStateTitleStyle}"/>
            <TextBlock Text="Подпишитесь на людей и сообщества — их публикации появятся здесь."
                       Style="{StaticResource EmptyStateBodyStyle}"/>
            <Button Content="Обновить"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Load failure -->
        <InfoBar Severity="Error"
                 Title="Не удалось обновить ленту"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 IsClosable="False"
                 VerticalAlignment="Top"
                 MaxWidth="1240"
                 Margin="24,24,24,0">
            <InfoBar.ActionButton>
                <Button Content="Повторить" Command="{x:Bind ViewModel.RefreshCommand}"/>
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Page>
