<Page
    x:Class="ovkdesktop.PostsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ovkdesktop.Controls"
    xmlns:models="using:ovkdesktop.Models"
    xmlns:converters="using:ovkdesktop.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <DataTemplate x:Key="UnifiedPostTemplate" x:DataType="models:BasePost">
            <controls:PostCardControl Post="{Binding}"
                                      AuthorInvoked="PostCard_AuthorInvoked"
                                      LikeInvoked="PostCard_LikeInvoked"
                                      CommentInvoked="PostCard_CommentInvoked"
                                      RepostInvoked="PostCard_RepostInvoked"/>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ListView x:Name="PostsListView"
                  Loaded="PostsListView_Loaded"
                  ItemsSource="{x:Bind ViewModel.NewsPosts, Mode=OneWay}"
                  ItemTemplate="{StaticResource UnifiedPostTemplate}"
                  SelectionMode="None"
                  Margin="125,24,125,0"
                  ShowsScrollingPlaceholders="False">
            
            <ListView.Header>
                <TextBlock x:Name="NewsPostsLabel" 
                           Text="Новости" 
                           Margin="0,81,0,20" 
                           Style="{ThemeResource TitleLargeTextBlockStyle}" 
                           FontSize="42" 
                           HorizontalAlignment="Left"/>
            </ListView.Header>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>


            <ListView.Footer>
                <StackPanel Margin="0,10,0,40">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" 
                                  Width="50" 
                                  Height="50" 
                                  Margin="0,0,0,10"/>

                    <Button Content="Загрузить ещё..."
                            Command="{x:Bind ViewModel.LoadMoreCommand}"
                            Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ListView.Footer>
        </ListView>

        <!-- Initial Loading Overlay -->
        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Spacing="15"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="True" Width="60" Height="60" />
            <TextBlock Text="Собираем свежие посты..." FontSize="16" Opacity="0.7" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
