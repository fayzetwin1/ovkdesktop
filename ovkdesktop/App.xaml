<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ovkdesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ovkdesktop.Converters"
    xmlns:local="using:ovkdesktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ClientContentBackgroundBrush" Color="#111318"/>
            <SolidColorBrush x:Key="ClientSidebarBackgroundBrush" Color="#191C22"/>
            <SolidColorBrush x:Key="ClientSurfaceBrush" Color="#1D2027"/>
            <SolidColorBrush x:Key="ClientNestedSurfaceBrush" Color="#252932"/>
            <SolidColorBrush x:Key="ClientPlayerBackgroundBrush" Color="#181B21"/>
            <!-- Other app resources here -->
            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>

            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
                <Setter Property="FontSize" Value="36"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Opacity" Value="0.68"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="SurfaceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ClientSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="18"/>
            </Style>
            <Style x:Key="CompactActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="11,7"/>
                <Setter Property="MinWidth" Value="38"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
