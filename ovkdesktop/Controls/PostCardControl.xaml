<UserControl
    x:Class="ovkdesktop.Controls.PostCardControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ovkdesktop.Controls"
    xmlns:models="using:ovkdesktop.Models"
    xmlns:converters="using:ovkdesktop.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:InverseIntToVisibilityConverter x:Key="InverseIntToVisibilityConverter"/>

        <DataTemplate x:Key="NestedPostTemplate" x:DataType="models:UserWallPost">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2"/>
                <!--
                    Post must use {Binding}, not {x:Bind}. This template is handed to a
                    plain ItemsControl, which never runs the compiled-binding hookup
                    (ProcessBindings) that x:Bind inside a DataTemplate depends on - so
                    x:Bind silently left Post null and every repost rendered as an empty
                    card with just the author row.
                -->
                <local:PostCardControl Grid.Column="1"
                                       Margin="8,0,0,0"
                                       Post="{Binding}"
                                       IsNested="True"
                                       ShowActions="False"
                                       AuthorInvoked="NestedPost_AuthorInvoked"
                                       CommentInvoked="NestedPost_CommentInvoked"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        Background/border/padding come from a Style rather than inline values, because
        the nested-repost variant swaps the whole Style in code-behind. Inline values
        would win over the Style and the swap would have no effect.
    -->
    <Border x:Name="CardBorder"
            Style="{StaticResource SurfaceCardStyle}"
            MaxWidth="1240"
            HorizontalAlignment="Stretch">
        <StackPanel Spacing="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Click="AuthorButton_Click"
                        AutomationProperties.Name="Открыть профиль автора">
                    <PersonPicture x:Name="AuthorPicture"
                                   Width="48"
                                   Height="48"
                                   ProfilePicture="{Binding Post.AuthorAvatarUrl, ElementName=Root}"/>
                </Button>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Click="AuthorButton_Click">
                        <TextBlock Text="{Binding Post.AuthorName, ElementName=Root}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Button>
                    <TextBlock Text="{Binding Post.FormattedDate, ElementName=Root}"
                               FontSize="12"
                               Opacity="0.65"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Post.Text, ElementName=Root}"
                       TextWrapping="Wrap"
                       IsTextSelectionEnabled="True"
                       Visibility="{Binding Post.Text, ElementName=Root, Converter={StaticResource StringToVisibilityConverter}}"/>

            <TextBlock Text="Запись без содержимого"
                       FontStyle="Italic"
                       Foreground="{ThemeResource ClientSubtleTextBrush}"
                       Visibility="{Binding Post.HasNoContent, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <local:PostMediaControl Attachments="{Binding Post.Attachments, ElementName=Root}"/>

            <TextBlock Text="{Binding Post.RepostSummary, ElementName=Root}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Opacity="0.68"
                       Visibility="{Binding Post.HasRepost, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                       Margin="0,2,0,-2"/>

            <ItemsControl ItemsSource="{Binding Post.DisplayCopyHistory, ElementName=Root}"
                          ItemTemplate="{StaticResource NestedPostTemplate}"
                          Visibility="{Binding Post.HasRepost, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                          Margin="0,2,0,0"/>

            <Grid x:Name="ActionsPanel"
                  Visibility="{Binding ShowActions, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                  Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--
                    Two hearts stacked on top of each other: the filled one shows through
                    once the post is liked. This replaces the old converter that only
                    recoloured the counter and could not tell the two states apart.
                -->
                <Button Grid.Column="0" Style="{StaticResource CompactActionButtonStyle}" Click="LikeButton_Click" Margin="0,0,8,0"
                        ToolTipService.ToolTip="Нравится"
                        AutomationProperties.Name="Нравится">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid>
                            <FontIcon Glyph="&#xEB51;" FontSize="15"
                                      Visibility="{Binding Post.Likes.UserLikes, ElementName=Root, Converter={StaticResource InverseIntToVisibilityConverter}}"/>
                            <FontIcon Glyph="&#xEB52;" FontSize="15"
                                      Foreground="{ThemeResource ClientLikeActiveBrush}"
                                      Visibility="{Binding Post.Likes.UserLikes, ElementName=Root, Converter={StaticResource IntToVisibilityConverter}}"/>
                        </Grid>
                        <TextBlock Text="{Binding Post.Likes.Count, ElementName=Root}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource CompactActionButtonStyle}" Click="CommentButton_Click" Margin="0,0,8,0"
                        ToolTipService.ToolTip="Комментарии"
                        AutomationProperties.Name="Комментарии">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8BD;" FontSize="15"/>
                        <TextBlock Text="{Binding Post.Comments.Count, ElementName=Root}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource CompactActionButtonStyle}" Click="RepostButton_Click"
                        ToolTipService.ToolTip="Поделиться"
                        AutomationProperties.Name="Поделиться">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72D;" FontSize="15"/>
                        <TextBlock Text="{Binding Post.Reposts.Count, ElementName=Root}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
