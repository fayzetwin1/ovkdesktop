<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ovkdesktop.SettingsClientPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ovkdesktop"
    xmlns:vm="using:ovkdesktop.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    Background="{ThemeResource ClientContentBackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="AccentSwatchTemplate" x:DataType="vm:AccentOptionViewModel">
            <Grid Width="46" Height="46"
                  ToolTipService.ToolTip="{x:Bind Name}"
                  AutomationProperties.Name="{x:Bind Name}">
                <Ellipse Width="38" Height="38" Fill="{x:Bind Fill, Mode=OneWay}"/>
                <FontIcon Glyph="{x:Bind Glyph}"
                          FontSize="15"
                          Foreground="{x:Bind GlyphBrush, Mode=OneWay}"
                          Visibility="{x:Bind GlyphVisibility}"/>
                <!-- ring drawn outside the swatch marks the active accent -->
                <Ellipse Width="46" Height="46"
                         Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                         StrokeThickness="2"
                         Visibility="{x:Bind SelectionVisibility, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderPanel.Margin" Value="24,48,24,20"/>
                        <Setter Target="ClientInfoPanel.Margin" Value="24,0,24,20"/>
                        <Setter Target="SettingsScrollViewer.Margin" Value="24,4,24,0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderPanel.Margin" Value="20,40,20,10"/>
                        <Setter Target="ClientInfoPanel.Margin" Value="20,0,20,10"/>
                        <Setter Target="ClientInfoLogo.Visibility" Value="Collapsed"/>
                        <Setter Target="SettingsScrollViewer.Margin" Value="20,4,20,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid Margin="0" MaxWidth="1240" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- header -->
                <RowDefinition Height="Auto"/>
                <!-- info about client -->
                <RowDefinition Height="*"/>
                <!-- settings -->
            </Grid.RowDefinitions>

            <!-- Header Panel -->
            <StackPanel x:Name="HeaderPanel" Grid.Row="0" Spacing="4">
                <TextBlock x:Name="SettingsClientLabel"
                           Text="Настройки клиента"
                           Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Внешний вид, интеграции и параметры аккаунта"
                           Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>

            <!-- Client Info Panel -->
            <Grid x:Name="ClientInfoPanel" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="ClientInfoLogo" Source="/Assets/Images/openvklogoScaled.png"
                       Height="88"
                       VerticalAlignment="Top"
                       Margin="0,0,22,0"/>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="NameOfClientLabel"
                               Text="OpenVK Desktop"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontSize="26"/>
                    <TextBlock x:Name="VersionOfClientLabel"
                               Text="версия: Release 2.5"
                               Style="{StaticResource SettingsHintTextStyle}"/>
                    <TextBlock x:Name="AuthorOfClientLabel"
                               Text="by Fayzetwin :3"
                               Style="{StaticResource SettingsHintTextStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Settings Content -->
            <Grid Grid.Row="2">

                <ScrollViewer x:Name="SettingsScrollViewer" Visibility="Collapsed">
                    <StackPanel Spacing="16" Padding="0,0,0,28">

                        <!-- ===== Appearance ===== -->
                        <Border Style="{StaticResource SurfaceCardStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE790;" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Внешний вид" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                </StackPanel>

                                <!-- theme mode -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Тема" FontWeight="SemiBold"/>
                                    <TextBlock Text="Определяет светлую или тёмную палитру клиента."
                                               Style="{StaticResource SettingsHintTextStyle}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,4,0,0">
                                        <RadioButton x:Name="ThemeSystemRadio"
                                                     Content="Системная"
                                                     GroupName="ThemeMode"
                                                     Tag="System"
                                                     Checked="ThemeModeRadio_Checked"/>
                                        <RadioButton x:Name="ThemeLightRadio"
                                                     Content="Светлая"
                                                     GroupName="ThemeMode"
                                                     Tag="Light"
                                                     Checked="ThemeModeRadio_Checked"/>
                                        <RadioButton x:Name="ThemeDarkRadio"
                                                     Content="Тёмная"
                                                     GroupName="ThemeMode"
                                                     Tag="Dark"
                                                     Checked="ThemeModeRadio_Checked"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource ClientSurfaceStrokeBrush}"/>

                                <!-- accent colour -->
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Акцентный цвет" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="AccentSummaryText"
                                                       Style="{StaticResource SettingsHintTextStyle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Сбросить"
                                                Click="ResetAppearance_Click"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource CompactActionButtonStyle}"
                                                ToolTipService.ToolTip="Вернуть системную тему и системный акцент"/>
                                    </Grid>

                                    <GridView x:Name="AccentGridView"
                                              ItemTemplate="{StaticResource AccentSwatchTemplate}"
                                              SelectionMode="None"
                                              IsItemClickEnabled="True"
                                              ItemClick="AccentGridView_ItemClick"
                                              Margin="0,6,0,0"
                                              Padding="0"
                                              AutomationProperties.Name="Акцентный цвет">
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="Margin" Value="0,0,10,10"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="MinWidth" Value="0"/>
                                                <Setter Property="MinHeight" Value="0"/>
                                                <Setter Property="CornerRadius" Value="23"/>
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                    </GridView>

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="CustomColorButton" Content="Свой цвет…">
                                            <Button.Flyout>
                                                <Flyout x:Name="CustomColorFlyout" Placement="Bottom">
                                                    <StackPanel Spacing="12">
                                                        <ColorPicker x:Name="AccentColorPicker"
                                                                     IsAlphaEnabled="False"
                                                                     IsHexInputVisible="True"
                                                                     IsColorChannelTextInputVisible="True"
                                                                     IsMoreButtonVisible="False"/>
                                                        <Button Content="Применить"
                                                                Style="{ThemeResource AccentButtonStyle}"
                                                                Click="ApplyCustomColor_Click"
                                                                HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- live preview so contrast problems are visible before committing -->
                                <Border Style="{StaticResource NestedSurfaceCardStyle}" Padding="16">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Предпросмотр" Style="{StaticResource SettingsHintTextStyle}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                            <Button Content="Кнопка" Style="{ThemeResource AccentButtonStyle}" IsTabStop="False"/>
                                            <ToggleSwitch IsOn="True" OnContent="" OffContent="" IsTabStop="False" MinWidth="0"/>
                                            <Slider Value="65" Width="120" VerticalAlignment="Center" IsTabStop="False"/>
                                            <HyperlinkButton Content="Ссылка" IsTabStop="False"/>
                                            <ProgressRing IsActive="True" Width="22" Height="22"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ===== Experimental ===== -->
                        <Border Style="{StaticResource SurfaceCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE945;" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Экспериментальные возможности" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="OpenVkApiV2Toggle"
                                              Header="Использовать OpenVK API 2.0 (execute)"
                                              OffContent="Выключено"
                                              OnContent="Включено"
                                              Toggled="OpenVkApiV2Toggle_Toggled"/>
                                <TextBlock Text="Объединяет API-запросы через метод execute. На неподдерживаемых инстансах клиент автоматически вернётся к обычным методам API. Функция может работать нестабильно."
                                           Style="{StaticResource SettingsHintTextStyle}"/>
                                <Border Style="{StaticResource NestedSurfaceCardStyle}" Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Сравнение производительности" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ApiPerformanceSummaryText" Style="{StaticResource SettingsHintTextStyle}"/>
                                        <Button Content="Обновить результаты" Click="RefreshApiPerformance_Click" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ===== Last.fm ===== -->
                        <Border Style="{StaticResource SurfaceCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Интеграция с Last.fm" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Text="Отправляйте информацию о прослушанных треках (скробблинг) в ваш профиль Last.fm."
                                           Style="{StaticResource SettingsHintTextStyle}"/>

                                <HyperlinkButton Content="Где взять API Key?" NavigateUri="https://www.last.fm/api/account/create" Padding="0,4"/>

                                <TextBox x:Name="LastFmApiKeyBox" Header="Last.fm API Key" MaxWidth="420" HorizontalAlignment="Left"/>
                                <PasswordBox x:Name="LastFmApiSecretBox" Header="Last.fm API Secret" MaxWidth="420" HorizontalAlignment="Left"/>

                                <Button x:Name="LastFmSaveKeysButton"
                                        Content="Сохранить ключи API"
                                        Click="LastFmSaveKeysButton_Click"
                                        HorizontalAlignment="Left"/>

                                <InfoBar x:Name="LastFmKeysInfoBar"
                                         Title="Ключи сохранены"
                                         Message="Теперь вы можете войти в свой аккаунт Last.fm."
                                         Severity="Success"
                                         IsOpen="False"
                                         IsClosable="True"/>

                                <ToggleSwitch x:Name="LastFmToggle"
                                              Header="Включить скробблинг"
                                              Toggled="LastFmToggle_Toggled"
                                              Margin="0,8,0,0"/>

                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Button x:Name="LastFmLoginButton"
                                            Content="Войти в Last.fm"
                                            Click="LastFmLoginButton_Click"/>
                                    <TextBlock x:Name="LastFmStatusText"
                                               Text="Статус: не выполнен вход"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SettingsHintTextStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== Account ===== -->
                        <Border Style="{StaticResource SurfaceCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE77B;" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Аккаунт" Style="{StaticResource SettingsSectionTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Text="Клиент перезапустится и вернётся к экрану входа. Настройки внешнего вида сохранятся."
                                           Style="{StaticResource SettingsHintTextStyle}"/>
                                <Button Content="Выйти из аккаунта OpenVK"
                                        Click="LogoutButton_Click"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <ProgressRing x:Name="LoadingRing"
                              IsActive="True"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Width="50" Height="50"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
