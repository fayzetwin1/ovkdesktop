<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ovkdesktop.AuthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ovkdesktop"
    xmlns:converters="using:ovkdesktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ClientContentBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Button Command="{x:Bind ViewModel.GoBackCommand}"
                Style="{StaticResource CompactActionButtonStyle}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                ToolTipService.ToolTip="Назад"
                AutomationProperties.Name="Вернуться назад">
            <FontIcon Glyph="&#xE72B;" FontSize="17"/>
        </Button>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="340"
                    Spacing="14">

            <Image Source="/Assets/Images/openvklogoScaled.png"
                   Height="56"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,4"/>

            <StackPanel Spacing="4">
                <TextBlock Text="Вход в аккаунт"
                           FontSize="26"
                           FontWeight="SemiBold"/>
                <!-- makes it obvious which server the credentials go to -->
                <TextBlock Text="{x:Bind ViewModel.InstanceDisplayName, Mode=OneWay}"
                           Style="{StaticResource SettingsHintTextStyle}"/>
            </StackPanel>

            <StackPanel Spacing="12" Margin="0,6,0,0">
                <TextBox x:Name="usernameTextBox"
                         Header="Почта или логин"
                         PlaceholderText="veselcraft@gmail.com"
                         MaxLength="60"
                         HorizontalAlignment="Stretch"
                         Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <PasswordBox x:Name="passwordTextBox"
                             Header="Пароль"
                             PlaceholderText="Введите пароль"
                             HorizontalAlignment="Stretch"
                             KeyDown="PasswordBox_KeyDown"
                             Password="{x:Bind ViewModel.Password, Mode=TwoWay}"/>

                <Button Command="{x:Bind ViewModel.LoginCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Width="16" Height="16"/>
                        <TextBlock Text="Войти"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,2,0,0">
                <TextBlock Text="Нет аккаунта?"
                           Style="{StaticResource SettingsHintTextStyle}"
                           VerticalAlignment="Center"/>
                <HyperlinkButton Content="Зарегистрироваться"
                                 Padding="6,2"
                                 Command="{x:Bind ViewModel.OpenRegistrationCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
