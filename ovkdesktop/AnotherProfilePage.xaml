<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ovkdesktop.AnotherProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ovkdesktop"
    xmlns:models="using:ovkdesktop.Models"
    xmlns:converters="using:ovkdesktop.Converters"
    xmlns:controls="using:ovkdesktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ClientContentBackgroundBrush}">

    <Page.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToMediaPlaybackSourceConverter x:Key="StringToMediaPlaybackSourceConverter"/>
        <converters:ProfileToImageConverter x:Key="ProfileToImageConverter"/>

        <DataTemplate x:Key="UnifiedPostTemplate" x:DataType="models:BasePost">
            <controls:PostCardControl Post="{Binding}"
                                      AuthorInvoked="PostCard_AuthorInvoked"
                                      LikeInvoked="PostCard_LikeInvoked"
                                      CommentInvoked="PostCard_CommentInvoked"
                                      RepostInvoked="PostCard_RepostInvoked"/>
        </DataTemplate>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,16,24,0" MaxWidth="1240" HorizontalAlignment="Stretch">
            <Button Click="BackPostsClick" AutomationProperties.Name="Back" 
                   Style="{StaticResource CompactActionButtonStyle}" HorizontalAlignment="Left">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                      TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!--
            The ListView owns the scrolling and the profile header lives in its Header,
            the same shape the news feed uses.

            It used to be a ListView nested inside a page-level ScrollViewer, which caused
            two separate defects:
              * the outer ScrollViewer measured with unbounded width, so a post containing
                an unbreakable run (an "=====" separator, a long URL) inflated the
                horizontal extent past the viewport and the MaxWidth column then centred
                itself inside that oversized extent - sliding the whole page to the right;
              * the inner ListView got unbounded height, lost virtualisation and
                materialised every post at once, so the layout thrashed while images and
                further pages loaded.
        -->
        <ListView x:Name="PostsListView"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Posts, Mode=OneWay}"
                  ItemTemplate="{StaticResource UnifiedPostTemplate}"
                  SelectionMode="None"
                  MaxWidth="1240"
                  HorizontalAlignment="Stretch"
                  Margin="24,10,24,0"
                  ShowsScrollingPlaceholders="False"
                  Loaded="PostsListView_Loaded">

            <ListView.Header>
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <PersonPicture Grid.Column="0"
                                      x:Name="ProfileAvatar"
                                      ProfilePicture="{x:Bind ViewModel.ProfilePhotoUrl, Mode=OneWay}"
                                      Width="120" Height="120" Margin="0,12,20,0" VerticalAlignment="Top"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ProfileNameTextBlock" Text="{x:Bind ViewModel.ProfileName, Mode=OneWay, FallbackValue='Загрузка...'}"
                                      Style="{StaticResource PageTitleTextStyle}"/>

                            <TextBlock Text="{x:Bind ViewModel.PostsCountText, Mode=OneWay, FallbackValue='Загрузка записей на стене'}"
                                       Style="{StaticResource PageSubtitleTextStyle}" Margin="0,5,0,12"/>

                            <StackPanel x:Name="FriendActionsPanel" Orientation="Horizontal" Visibility="{x:Bind ViewModel.IsUser, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button x:Name="AddFriendButton" Command="{x:Bind ViewModel.ToggleFriendshipCommand}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE8FA;" FontSize="16"/>
                                        <TextBlock Text="Добавить в друзья"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="GroupActionsPanel" Orientation="Horizontal" Visibility="{x:Bind ViewModel.IsGroup, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="10">
                                <Button x:Name="JoinLeaveGroupButton" Command="{x:Bind ViewModel.ToggleGroupMembershipCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon x:Name="JoinLeaveIcon" Glyph="&#xE710;"/>
                                        <TextBlock x:Name="JoinLeaveText" Text="Подписаться"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ProgressRing x:Name="LoadingProgressRing" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                 Width="50" Height="50"
                                 HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </ListView.Header>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.Footer>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                             Width="30" Height="30"
                             HorizontalAlignment="Center" Margin="0,20,0,24"/>
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
