<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ovkdesktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ovkdesktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ClientContentBackgroundBrush}"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!--
        PlacementMode is Hidden because the accelerators below live on the Page itself:
        with the default Auto, WinUI renders their tooltip against the accelerator owner,
        so "Ctrl+1" followed the pointer around the whole window.
    -->
    <Page.KeyboardAccelerators>
        <!-- Ctrl+1..5 jump straight to a section, F5 / Ctrl+R reloads it -->
        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="NavAccelerator_Invoked"/>
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked"/>
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="RefreshAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" HorizontalAlignment="Stretch">
            <NavigationView x:Name="NavView"
                            IsSettingsVisible="False"
                            IsBackButtonVisible="Auto"
                            BackRequested="NavView_BackRequested"
                            PaneTitle="OpenVK Desktop"
                            PaneDisplayMode="Auto"
                            CompactPaneLength="56"
                            OpenPaneLength="260"
                            HorizontalAlignment="Stretch"
                            ItemInvoked="NavView_ItemInvoked">
                <!-- pane colours come from Themes/ClientPalette.xaml so they follow the theme -->
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NewsItem" Content="Новости" Icon="Message" Tag="news"
                                        ToolTipService.ToolTip="Новости (Ctrl+1)"/>
                    <NavigationViewItem x:Name="ProfileItem" Content="Профиль" Icon="Contact" Tag="profile"
                                        ToolTipService.ToolTip="Профиль (Ctrl+2)"/>
                    <NavigationViewItem x:Name="GroupsItem" Content="Сообщества" Tag="groups"
                                        ToolTipService.ToolTip="Сообщества (Ctrl+3)">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE902;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="MusicItem" Content="Музыка" Icon="MusicInfo" Tag="music"
                                        ToolTipService.ToolTip="Музыка (Ctrl+4)"/>
                    <NavigationViewItem x:Name="FriendsItem" Content="Друзья" Icon="People" Tag="friends"
                                        ToolTipService.ToolTip="Друзья (Ctrl+5)"/>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem x:Name="SettingsItem" Content="Настройки" Icon="Setting" Tag="settings"
                                        ToolTipService.ToolTip="Настройки клиента"/>
                </NavigationView.FooterMenuItems>
                <Frame x:Name="ContentFrame" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </NavigationView>
        </Grid>
        
        <!-- Container for mini player -->
        <ContentControl Grid.Row="1" 
                x:Name="MiniPlayerContainer" 
                Background="{ThemeResource ClientPlayerBackgroundBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                BorderThickness="0,1,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
            <!-- Content will be added programmatically -->
        </ContentControl>
    </Grid>
</Page>
